---
interface Props { espaciado?: 'normal' | 'amplio' }
const { espaciado = 'normal' } = Astro.props;
---
<ul class:list={['list', espaciado === 'amplio' && 'list--wide']}><slot /></ul>
<style>
  .list {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: var(--sp-3);
  }
  .list--wide { gap: var(--sp-5); }
</style>
