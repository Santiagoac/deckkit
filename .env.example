# Copy to .env for local development only:  cp .env.example .env
#
# .env is gitignored and NOTHING reads it in production. The deployed edge
# function reads Netlify's own environment (Netlify.env.get), so these values
# have to be set in the Netlify UI — a .env in the repo would not reach it.
#
# Set them here only if you run `netlify dev` and want the index password
# prompt to behave locally the way it does in production.
#
# Never commit real values. The shared credential belongs in the team password
# manager; Netlify is where production reads it from.

DECK_INDEX_USER=
DECK_INDEX_PASSWORD=
