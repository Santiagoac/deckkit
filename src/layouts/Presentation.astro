---
import '../styles/tokens.generated.css';
import '../styles/base.css';
import { loadCanon, googleFontsHref, loadLanguage } from '../../scripts/lib/canon.mjs';
import { uiStrings, normalizeLanguage } from '../../scripts/lib/ui.mjs';

const canon = loadCanon(process.cwd());
// Google-hosted families get one stylesheet link; licensed ones load locally (see README).
const fontsHref = googleFontsHref(canon);
const lang = normalizeLanguage(loadLanguage(process.cwd()));
const ui = uiStrings(lang);

interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={canon.logo.dark} />
    {fontsHref && <link rel="stylesheet" href={fontsHref} />}
  </head>
  <body>
    <div class="progress"><div class="progress__bar"></div></div>

    <div class="topbar" aria-label="Deck navigation">
      <a class="topbar__home" href="/">{ui.backToDecks}</a>
      <span class="topbar__title">{title}</span>
    </div>

    <main class="deck" data-mode="normal">
      <slot />
    </main>

    <nav class="controls" aria-label="Deck controls">
      <button type="button" data-action="overview" aria-label="All slides (O)">▦</button>
      <button type="button" data-action="prev" aria-label="Slide prev">←</button>
      <span class="controls__counter" aria-live="polite">1 / 1</span>
      <button type="button" data-action="next" aria-label="Slide next">→</button>
      <button type="button" data-action="present" aria-label="Mode presentación (P)">⛶</button>
    </nav>

    <aside class="notes" aria-label="Speaker notes"></aside>

    <script>
      import '../deck/runtime.ts';
    </script>
  </body>
</html>
