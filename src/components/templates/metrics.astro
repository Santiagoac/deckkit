---
import Slide from '../Slide.astro';
import { getCollection } from 'astro:content';
interface Props { background: any; accent?: any; title: string; footer?: string; notes?: string }
const { background, accent, footer, notes } = Astro.props;
const logos = (await getCollection('logos')).filter((l) => l.data.group === 'customers');
---
<Slide background={background} accent={accent} footer={footer} notes={notes}>
  <div class="metrics">
    <div class="metrics__row"><slot /></div>
    {logos.map((l) => (
      <img class="metrics__logos" src={l.data.src} alt={l.data.alt} loading="eager" />
    ))}
  </div>
</Slide>
<style>
  .metrics { display: flex; flex-direction: column; gap: var(--sp-10); justify-content: center; }
  .metrics__row {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-6);
  }
  .metrics__logos { width: 100%; max-width: 1100px; margin: 0 auto; opacity: 0.95; }
  @media (max-width: 900px) {
    .metrics { gap: var(--sp-5); }
    .metrics__row { grid-template-columns: 1fr; gap: var(--sp-3); }
  }
</style>
