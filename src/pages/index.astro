---
import { getCollection } from 'astro:content';
import '../styles/tokens.generated.css';
import '../styles/base.css';
import { loadCanon, googleFontsHref, loadLanguage } from '../../scripts/lib/canon.mjs';
import { uiStrings, normalizeLanguage } from '../../scripts/lib/ui.mjs';

const canon = loadCanon(process.cwd());
const fontsHref = googleFontsHref(canon);
const lang = normalizeLanguage(loadLanguage(process.cwd()));
const t = uiStrings(lang);

const decks = (await getCollection('decks')).sort((a, b) =>
  a.data.status === b.data.status ? 0 : a.data.status === 'published' ? -1 : 1,
);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.decks}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href={canon.logo.dark} />
    {fontsHref && <link rel="stylesheet" href={fontsHref} />}
  </head>
  <body>
    <main class="selector">
      <img class="selector__logo" src={canon.logo.dark} alt={canon.name} height="28" />
      <h1 class="selector__title">{t.decks}</h1>
      <p class="selector__nota">{t.indexNote}</p>
      <ul class="selector__list">
        {decks.map((r) => (
          <li>
            {r.data.status === 'published' ? (
              <div class="fila">
                <a class="tarjeta" href={`/${r.data.slug}`}>
                  <span class="tarjeta__nombre">{r.data.name}</span>
                  <span class="tarjeta__meta">{r.data.slides.length} {t.slideCount}</span>
                </a>
                {/* <details> so the panel opens and closes with no JS of its own.
                    The script below only builds the URL and copies it. */}
                <details class="share" data-slug={r.data.slug}>
                  <summary class="share__toggle">{t.share}</summary>
                  {/* Only painted on a phone, where the panel is a sheet and
                      needs something to tap to dismiss. */}
                  <div class="share__fondo" aria-hidden="true"></div>
                  <div class="share__panel">
                    <div class="share__modes" role="radiogroup" aria-label={t.share}>
                      <label><input type="radio" name={`m-${r.data.slug}`} value="normal" checked /> {t.shareNormal}</label>
                      <label><input type="radio" name={`m-${r.data.slug}`} value="story" /> {t.shareStory}</label>
                    </div>
                    <div class="share__seconds" hidden>
                      <span class="share__label">{t.shareSeconds}</span>
                      <div class="share__opciones" role="radiogroup" aria-label={t.shareSeconds}>
                        {/* 15 is for a deck someone reads rather than skims —
                            a dense slide needs longer than a cover. */}
                        {[3, 5, 8, 15].map((s) => (
                          <label><input type="radio" name={`s-${r.data.slug}`} value={s} checked={s === 5} /> {s}s</label>
                        ))}
                      </div>
                    </div>
                    <input class="share__url" readonly aria-label="URL" />
                    <button type="button" class="share__copy" data-copied={t.shareCopied}>{t.shareCopy}</button>
                  </div>
                </details>
              </div>
            ) : (
              <span class="tarjeta tarjeta--borrador">
                <span class="tarjeta__nombre">{r.data.name}</span>
                <span class="tarjeta__meta">{t.draft}</span>
              </span>
            )}
          </li>
        ))}
      </ul>
    </main>
    <style>
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--font-body); }
      .selector { max-width: 640px; margin: 0 auto; padding: var(--sp-10) var(--sp-3); display: flex; flex-direction: column; gap: var(--sp-2); }
      /* Sized by HEIGHT, not width: this is a masthead, not a hero. A fixed
         width assumed every logo is a wide wordmark — a square monogram at
         width 220 rendered 220px tall and swallowed the page. Height plus
         width:auto holds any proportion; max-width only guards a freakishly
         wide lockup, and object-fit keeps it from squashing if it hits. */
      .selector__logo {
        display: block; height: 28px; width: auto;
        max-width: 240px; object-fit: contain; object-position: left;
        margin-bottom: var(--sp-6);
      }
      .selector__title { margin: 0; font-size: 2rem; font-weight: 700; line-height: 1.2; }
      .selector__nota { margin: 0 0 var(--sp-4); color: color-mix(in srgb, var(--ink) 72%, var(--paper)); }
      .selector__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--sp-2); }
      .tarjeta {
        display: flex; align-items: baseline; justify-content: space-between; gap: var(--sp-2);
        padding: var(--sp-3); border: 1px solid color-mix(in srgb, var(--ink) 15%, var(--paper)); border-radius: 12px;
        background: #fff; text-decoration: none; color: inherit;
      }
      a.tarjeta:hover { border-color: var(--brand); }
      a.tarjeta:focus-visible { outline: 2px solid var(--brand-light); outline-offset: 2px; }
      .tarjeta--borrador { opacity: 0.55; }
      .tarjeta__nombre { font-weight: 500; }
      .tarjeta__meta { font-family: var(--font-mono); font-size: 0.875rem; color: color-mix(in srgb, var(--ink) 55%, var(--paper)); }
      .fila { display: flex; align-items: stretch; gap: var(--sp-2); }
      .fila .tarjeta { flex: 1; }
      .share { position: relative; }
      /* Inert until the mobile query gives it a box. */
      .share__fondo { display: none; }
      @media (max-width: 560px) { .share[open] .share__fondo { display: block; } }
      .share__toggle {
        list-style: none; cursor: pointer; user-select: none;
        display: grid; place-items: center; height: 100%;
        padding: 0 var(--sp-3); white-space: nowrap;
        border: 1px solid color-mix(in srgb, var(--ink) 15%, var(--paper));
        border-radius: 12px; background: #fff;
        font-size: 0.875rem; color: color-mix(in srgb, var(--ink) 70%, var(--paper));
      }
      .share__toggle::-webkit-details-marker { display: none; }
      .share__toggle:hover { border-color: var(--brand); }
      .share[open] .share__toggle { border-color: var(--brand); color: var(--ink); }
      .share__panel {
        position: absolute; right: 0; top: calc(100% + var(--sp-1)); z-index: 5;
        width: min(320px, 78vw);
        display: flex; flex-direction: column; gap: var(--sp-2);
        padding: var(--sp-3); border-radius: 12px; background: #fff;
        border: 1px solid color-mix(in srgb, var(--ink) 15%, var(--paper));
        box-shadow: 0 8px 24px color-mix(in srgb, var(--ink) 12%, transparent);
      }
      .share__modes, .share__opciones { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
      .share__panel label {
        display: flex; align-items: center; gap: 6px;
        font-size: 0.875rem; cursor: pointer;
      }
      .share__label {
        font-family: var(--font-mono); font-size: 0.75rem;
        text-transform: uppercase; letter-spacing: 0.06em;
        color: color-mix(in srgb, var(--ink) 55%, var(--paper));
      }
      .share__seconds { display: flex; flex-direction: column; gap: 6px; }
      /* An author `display` beats the UA rule behind [hidden], so without this
         the seconds stay on screen while Normal is selected. */
      .share__seconds[hidden] { display: none; }
      .share__url {
        width: 100%; box-sizing: border-box;
        font-family: var(--font-mono); font-size: 0.75rem;
        padding: var(--sp-2); border-radius: 8px; color: var(--ink);
        border: 1px solid color-mix(in srgb, var(--ink) 15%, var(--paper));
        background: color-mix(in srgb, var(--ink) 4%, var(--paper));
      }
      .share__copy {
        padding: var(--sp-2); border: 0; border-radius: 8px; cursor: pointer;
        background: var(--brand-light); color: var(--ink);
        font-family: var(--font-body); font-size: 0.875rem; font-weight: 600;
      }
      @media (max-width: 560px) {
        /* The button stays on the row, beside the deck — wrapping it to a
           second full-width row made every deck look like two things. A
           popover pinned to it would be cramped, so the options arrive as a
           sheet from the bottom, which is where a phone expects them. */
        .share__toggle { padding: 0 var(--sp-3); }

        .share__panel {
          position: fixed; inset: auto 0 0 0; width: auto; z-index: 20;
          border-radius: 16px 16px 0 0; border-width: 1px 0 0;
          padding: var(--sp-4) var(--sp-3);
          padding-bottom: max(var(--sp-4), env(safe-area-inset-bottom));
          gap: var(--sp-3);
          box-shadow: 0 -8px 32px color-mix(in srgb, var(--ink) 20%, transparent);
          animation: sube-sheet 220ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
        }
        /* The grab handle every bottom sheet has. Decoration, but its absence
           is what makes a fixed panel read as a bug. */
        .share__panel::before {
          content: ''; width: 36px; height: 4px; border-radius: 2px;
          margin: calc(var(--sp-2) * -1) auto var(--sp-1);
          background: color-mix(in srgb, var(--ink) 20%, var(--paper));
        }
        .share[open] .share__fondo {
          position: fixed; inset: 0; z-index: 19;
          background: color-mix(in srgb, var(--ink) 40%, transparent);
          animation: aparece-fondo 220ms ease both;
        }
        .share__modes, .share__opciones { gap: var(--sp-4); }
        .share__panel label { padding: var(--sp-1) 0; }
        .share__copy { padding: var(--sp-3); font-size: 1rem; }
      }
      @keyframes sube-sheet { from { transform: translateY(100%); } }
      @keyframes aparece-fondo { from { opacity: 0; } }
      @media (prefers-reduced-motion: reduce) {
        .share__panel, .share[open] .share__fondo { animation: none; }
      }
    </style>

    <script>
      import { buildShareUrl } from '../../scripts/lib/story.mjs';

      const COPIED_MS = 1600;

      const paneles = document.querySelectorAll<HTMLDetailsElement>('.share');

      // Two sheets open at once is never what anyone meant.
      paneles.forEach((p) => p.addEventListener('toggle', () => {
        if (p.open) paneles.forEach((o) => { if (o !== p) o.removeAttribute('open'); });
      }));

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') paneles.forEach((p) => p.removeAttribute('open'));
      });

      paneles.forEach((panel) => {
        const slug = panel.dataset.slug!;
        const seconds = panel.querySelector<HTMLElement>('.share__seconds')!;
        const field = panel.querySelector<HTMLInputElement>('.share__url')!;
        const copy = panel.querySelector<HTMLButtonElement>('.share__copy')!;
        const original = copy.textContent!;

        const read = () => ({
          mode: panel.querySelector<HTMLInputElement>('input[value="story"]')!.checked ? 'story' : 'normal',
          seconds: Number(panel.querySelector<HTMLInputElement>('input[name^="s-"]:checked')?.value ?? 5),
        });

        const refresh = () => {
          const { mode, seconds: s } = read();
          seconds.hidden = mode !== 'story';
          // Absolute, because the point of this field is to be pasted somewhere
          // else — a relative path would be useless in an email.
          field.value = buildShareUrl(new URL(`/${slug}`, location.origin).toString(), { mode, seconds: s });
        };

        panel.addEventListener('change', refresh);
        refresh();

        // A <details> stays open until its own summary is clicked again, which
        // is wrong for a sheet: on a phone you dismiss by tapping away from it.
        panel.querySelector('.share__fondo')!.addEventListener('click', () => {
          panel.removeAttribute('open');
        });

        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(field.value);
          } catch {
            // No clipboard permission, or an insecure origin. Select it so the
            // person can copy by hand instead of getting nothing.
            field.focus(); field.select();
            return;
          }
          copy.textContent = copy.dataset.copied!;
          setTimeout(() => { copy.textContent = original; }, COPIED_MS);
        });
      });
    </script>
  </body>
</html>
