{
  "name": "deckkit",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Present it like a deck, share it like a link.",
  "license": "MIT",
  "scripts": {
    "canon": "node scripts/build-canon.mjs",
    "predev": "npm run canon && npm run deck:urls",
    "prebuild": "npm run canon",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node scripts/no-secrets.mjs && node --test \"scripts/**/*.test.mjs\"",
    "check": "node scripts/check.mjs",
    "evals": "node --test \"evals/**/*.test.mjs\"",
    "import-deck": "node scripts/import-deck.mjs",
    "deck:slug": "node scripts/deck-slug.mjs",
    "no-secrets": "node scripts/no-secrets.mjs",
    "deck:urls": "node scripts/deck-urls.mjs",
    "postbuild": "npm run deck:urls",
    "update": "node scripts/update.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.0",
    "astro": "^5.13.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}
