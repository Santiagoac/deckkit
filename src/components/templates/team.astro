---
import Slide from '../Slide.astro';
import Title from '../Title.astro';
import { getCollection } from 'astro:content';
interface Props { background: any; accent?: any; title: string; footer?: string; notes?: string }
const { background, accent, title, footer, notes } = Astro.props;
const persons = await getCollection('team');
---
<Slide background={background} accent={accent} footer={footer} notes={notes}>
  <div class="team">
    <div class="team__title"><Title text={title} /></div>
    <ul class="team__grid">
      {persons.map((p) => (
        <li class="person">
          <img class="person__photo" src={p.data.photo} alt="" loading="eager" width="400" height="400" />
          <p class="person__name">{p.data.name}</p>
          <p class="person__role">{p.data.role}</p>
        </li>
      ))}
    </ul>
  </div>
</Slide>
<style>
  .team { display: flex; flex-direction: column; gap: var(--sp-5); min-height: 0; }
  .team__title { text-align: center; }
  /* Flex rather than grid: the roster changes, and an incomplete last row
     should sit centered instead of hugging the left. */
  .team__grid {
    list-style: none; margin: 0; padding: 0; min-height: 0;
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: var(--sp-3) var(--sp-4);
  }
  .person { flex: 0 1 calc(25% - var(--sp-4)); }
  .person { display: flex; flex-direction: column; align-items: center; gap: var(--sp-1); min-height: 0; }
  .person__photo {
    width: clamp(56px, 8cqi, 108px); height: auto; aspect-ratio: 1;
    border-radius: 50%; object-fit: cover;
  }
  .person__name, .person__role {
    margin: 0; text-align: center; font-size: var(--t-mini); color: var(--fg); line-height: 1.3;
  }
  .person__name { font-weight: 500; }
  @media (max-width: 900px) { .person { flex-basis: calc(33.333% - var(--sp-4)); } }
  @media (max-width: 560px) { .person { flex-basis: calc(50% - var(--sp-4)); } }
</style>
